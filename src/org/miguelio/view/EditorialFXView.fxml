<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.miguelio.controller.EditorialFXController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding><Insets right="20" /></padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registra tu Editorial" />
            <TextField fx:id="txtNit" promptText="NIT" />
            <TextField fx:id="txtNombre" promptText="Nombre" />
            <TextField fx:id="txtTelefono" promptText="Telefono" />
            <TextField fx:id="txtDireccion" promptText="Direccion" />
            <HBox spacing="10">
                <Button onAction="#handleGuardarEditorial" prefWidth="120" text="Guardar" />
                <Button onAction="#handleLimpiarEditorial" prefWidth="120" text="Limpiar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Editoriales" />
            <TableView fx:id="tablaEditorial">
                <columns>
                    <TableColumn prefWidth="120" text="NIT">
                        <cellValueFactory>
                            <PropertyValueFactory property="NIT" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="140" text="Nombre">
                        <cellValueFactory>
                            <PropertyValueFactory property="nombre" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="140" text="Telefono">
                        <cellValueFactory>
                            <PropertyValueFactory property="telefono" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="200" text="Direccion">
                        <cellValueFactory>
                            <PropertyValueFactory property="direccion" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#handleActualizarEditorial" text="Actualizar Tabla" />
                <Button onAction="#handleVolverEditorial" text="Volver al Menú" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
