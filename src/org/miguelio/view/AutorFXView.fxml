<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.miguelio.controller.AutorFXController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding><Insets right="20" /></padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Autor" />
            <TextField fx:id="txtID" promptText="Id" />
            <TextField fx:id="txtNombre" promptText="Nombre" />
         <TextField fx:id="txtApellido" promptText="Apellido" />
            <TextField fx:id="txtNacionalidad" promptText="Nacionalidad" />
         <TextField fx:id="txtBiografia" promptText="Biografia" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Autores" />
            <TableView fx:id="tablaAutor">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="100" text="Id" />
                      
                    <TableColumn fx:id="colNombre" prefWidth="150" text="Nombre" />
                   <TableColumn fx:id="colApellido" text="Apellido" />

                    <TableColumn fx:id="colNacionalidad" prefWidth="140" text="Nacionalidad" />
               <TableColumn fx:id="colBiografia" prefWidth="200" text="Biografia" />
                      
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#handleActualizar" text="Actualizar Tabla" />
                <Button onAction="#handleVolver" text="Volver al Menú" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
